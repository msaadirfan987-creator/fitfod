# Local Express backend URL (leave unset in production to use Next.js /api routes)
NEXT_PUBLIC_API_URL=http://localhost:5000

# Required on live Next.js deployment (e.g. Vercel) when using built-in /api routes
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
